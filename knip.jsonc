{
  "$schema": "https://unpkg.com/knip@latest/schema-jsonc.json",
  "ignore": [
    // Root maintenance scripts are invoked by package.json scripts, not the
    // production runtime graph.
    "scripts/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // The exports below are consumed only by their colocated *.test.ts suites
    // (knip --production excludes test files, so they surface there). They are
    // deliberate test seams, not dead code: the SSR cache reset, the scheduler
    // eligibility predicate, model-list modality mappers, SSE stream
    // transforms, the transcription profile parser, and nav prefix/direction
    // helpers.
    "apps/server/src/ssr-cache.ts": ["exports"],
    "apps/server/src/model-api/capacity/scheduler.ts": ["exports"],
    "apps/server/src/model-api/model-list-modalities.ts": ["exports"],
    "apps/server/src/model-api/protocols/streams.ts": ["exports"],
    "apps/server/src/model-api/transcription-request.ts": ["exports"],
    "apps/web/src/lib/nav-items.ts": ["exports"],
    // resolveRouteSession is @deprecated (prefer resolveRouteSessionFromAuth);
    // kept only for the projection-assertion tests documented on it.
    "apps/web/src/server/auth-session.ts": ["exports"],
    // Type-level contract assertion: McpContext must satisfy the production
    // oRPC Context. No value-space consumer by design; the constraint is
    // checked at declaration time.
    "apps/server/src/mcp/context.ts": ["types"],
    // ALL_AGENT_SCOPES is AGENT_SCOPES widened to readonly AgentScope[] for
    // the test suites that pass every scope; the same value under two names is
    // deliberate.
    "packages/auth/src/agent-scopes.ts": ["duplicates"]
  },
  "workspaces": {
    ".": {
      // Shell/image entry points are not visible through static imports.
      "entry": ["scripts/backup/*.mjs!", "scripts/db/*.mjs!", "scripts/db/lib/local-db-name.mjs!"],
      "ignoreDependencies": [
        // The migration scripts load pg from packages/db's dependency closure
        // (scripts/db/lib/prisma.mjs loadPg). Do not add pg to the root
        // package.json: a hoisted root pg makes the web SSR build leave `pg`
        // external, and the image's apps/web/node_modules has no pg.
        "pg"
      ],
      "ignoreBinaries": [
        // PostgreSQL client tools supplied by the runtime image, not npm.
        "psql",
        "pg_restore",
        // Global local-dev CLI. Intentionally not listed in package.json.
        "portless"
      ]
    },
    "apps/web": {
      "entry": [
        // SPA/SSR entry points. `!` suffix = production entry (kept when
        // running `knip --production`, which excludes dev-only files).
        "src/routes/**/*.tsx!",
        "src/hooks/*.ts!",
        "src/stores/*.ts!",
        // The live-transcription microphone AudioWorklet (loaded by URL). Its
        // Chat Test loader went with the 0.4.0 route skeleton; kept for the
        // mic panel's return.
        "public/realtime-pcm-worklet.js!"
      ],
      "ignoreDependencies": [
        // Imported only via PostCSS/Tailwind CSS pipeline, not statically.
        "tailwindcss",
        "postcss",
        // Toast primitive re-exported from @ws-model-proxy/ui.
        "sileo"
      ]
    },
    "apps/server": {
      "ignoreDependencies": [
        // Imported by packages/auth, not by the server itself: declaring them keeps them external
        // in the tsdown bundle, so @better-auth/mcp and packages/auth share one instance
        // (enforced by src/better-auth-single-instance.test.ts).
        "@better-auth/cimd",
        "@better-auth/oauth-provider"
      ]
    },
    "packages/ui": {
      "entry": ["src/components/**/*.tsx", "src/styles/**/*.css"]
    },
    "packages/api": {
      "ignoreDependencies": ["@orpc/openapi"]
    },
    "packages/db": {
      "ignoreDependencies": ["@prisma/client", "zod"]
    }
  }
}
