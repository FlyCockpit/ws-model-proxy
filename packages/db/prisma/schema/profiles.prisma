// ───────────────────────────── Profiles ─────────────────────────────

/// A named desired state: which runtime versions run where. Applying it owns the nodes it
/// lists: other STARTABLE instances there are stopped; ALWAYS_ON runtimes are never touched.
model Profile {
  id           String   @id @default(cuid(2))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  userId       String
  slug         String
  name         String
  description  String?
  editor       Actor
  editorUserId String

  User       User               @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Nodes      ProfileNode[]
  Items      ProfileItem[]
  Operations RuntimeOperation[]

  @@unique([userId, slug])
  @@unique([id, userId])
  @@map("profile")
}

/// A node the profile owns.
model ProfileNode {
  profileId String
  nodeId    String

  Profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Node    Node    @relation(fields: [nodeId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([profileId, nodeId])
  @@index([nodeId])
  @@map("profile_node")
}

/// "Run `count` instances of this pinned runtime version", optionally only on some of the
/// profile's nodes. Pins move only through an explicit "Update pins".
model ProfileItem {
  id        String   @id @default(cuid(2))
  profileId String
  position  Int
  runtimeId String
  versionId String
  count     Int      @default(1)
  /// Optional subset of the profile's nodes; empty = any of them.
  nodeIds   String[] @default([])

  Profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  /// NoAction: deleting a pinned runtime is refused (`pinned_by_profile`); a user deletion
  /// removes profiles first (ordered sweep) and the check runs at statement end.
  Runtime Runtime        @relation(fields: [runtimeId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  Version RuntimeVersion @relation(fields: [versionId], references: [id], onDelete: NoAction, onUpdate: Cascade)

  @@unique([profileId, position])
  @@index([runtimeId])
  @@index([versionId])
  @@map("profile_item")
}
