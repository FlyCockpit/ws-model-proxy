enum DeploymentActor {
  USER
  AGENT
  SCHEDULE
}

enum DeploymentDesiredState {
  RUNNING
  STOPPED
}

enum DeploymentObservedState {
  PENDING
  STARTING
  RUNNING
  UNHEALTHY
  STOPPING
  STOP_PENDING
  STOPPED
  FAILED
}

enum DeploymentPlanState {
  PENDING
  AWAITING_CONFIRMATION
  APPLIED
  EXPIRED
}

enum DeploymentStepState {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  /// An interactive step whose operator terminal is open (or was closed without success) and
  /// waits for a person. Entered only from RUNNING; left only for RUNNING, PENDING, FAILED or
  /// (with the acceptance in the same update) SUCCEEDED (schema-hardening.sql).
  /// Declared last so fresh and upgraded databases share one enum order.
  AWAITING_OPERATOR
}

/// Why an instance waits for a person. Kept apart from `observedState` on purpose:
/// "stopped, needs you" is STOPPED + desired RUNNING + RESTART.
enum DeploymentOperatorNeed {
  /// An interactive step is AWAITING_OPERATOR.
  STEP
  /// An interactive start stopped; only a human restart brings it back.
  RESTART
}

/// Outcome codes of the operator-terminal audit log (`DeploymentOperatorEvent`).
enum DeploymentOperatorOutcome {
  opened
  accepted
  succeeded
  failed
  declined
  closed
  auto_settled
  cancelled
}

model DeploymentConfig {
  id        String                     @id @default(cuid(2))
  userId    String
  /// Null after its pool was deleted: the recipe and its history remain, but nothing can start
  /// from it until the owner rebinds it to a pool with a new revision.
  poolId    String?
  slug      String
  name      String
  createdAt DateTime                   @default(now())
  updatedAt DateTime                   @default(now()) @updatedAt
  User      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  Pool      ModelPool?                 @relation(fields: [poolId], references: [id], onDelete: Restrict)
  Revisions DeploymentConfigRevision[]
  Instances DeploymentInstance[]

  @@unique([userId, slug])
  @@map("deployment_config")
}

model DeploymentConfigRevision {
  id          String               @id @default(cuid(2))
  configId    String
  revision    Int
  createdAt   DateTime             @default(now())
  editorId    String
  editorKind  DeploymentActor
  contentHash String
  spec        Json
  Config      DeploymentConfig     @relation(fields: [configId], references: [id], onDelete: Cascade)
  Instances   DeploymentInstance[]

  @@unique([configId, revision])
  @@map("deployment_config_revision")
}

model DeploymentPlan {
  id            String              @id @default(cuid(2))
  userId        String
  requesterId   String
  requesterKind DeploymentActor
  createdAt     DateTime            @default(now())
  expiresAt     DateTime
  state         DeploymentPlanState
  fingerprint   String
  contents      Json
  confirmedBy   String?
  confirmedAt   DateTime?
  User          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  Run           DeploymentRun?

  @@index([userId, state, expiresAt])
  @@map("deployment_plan")
}

model DeploymentRun {
  id          String               @id @default(cuid(2))
  planId      String               @unique
  createdAt   DateTime             @default(now())
  completedAt DateTime?
  Plan        DeploymentPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  Instances   DeploymentInstance[]
  Steps       DeploymentStep[]

  @@map("deployment_run")
}

model DeploymentInstance {
  id                         String                   @id @default(cuid(2))
  userId                     String
  configId                   String
  revisionId                 String
  runId                      String
  variantKey                 String
  endpointSlug               String
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @default(now()) @updatedAt
  desiredState               DeploymentDesiredState   @default(RUNNING)
  observedState              DeploymentObservedState  @default(PENDING)
  startedBy                  DeploymentActor
  agentsMayPreempt           Boolean                  @default(false)
  restartAttempts            Int                      @default(0)
  nextRestartAt              DateTime?
  healthFailures             Int                      @default(0)
  healthSuccesses            Int                      @default(0)
  lastHealthAt               DateTime?
  /// Set (with `needsOperatorSince`) while the instance waits for a person; see
  /// DeploymentOperatorNeed. RESTART only with desired RUNNING and observed STOPPED/FAILED.
  needsOperator              DeploymentOperatorNeed?
  needsOperatorSince         DateTime?
  /// When a person last asked for a restart of an interactive start.
  operatorRestartRequestedAt DateTime?
  User                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Config                     DeploymentConfig         @relation(fields: [configId], references: [id], onDelete: Restrict)
  Revision                   DeploymentConfigRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  Run                        DeploymentRun            @relation(fields: [runId], references: [id], onDelete: Restrict)
  Nodes                      DeploymentInstanceNode[]
  Steps                      DeploymentStep[]
  Endpoint                   Endpoint?

  @@unique([userId, endpointSlug])
  @@index([userId, desiredState, observedState])
  @@map("deployment_instance")
}

model DeploymentInstanceNode {
  id               String             @id @default(cuid(2))
  instanceId       String
  cliDeviceId      String
  rank             Int
  resources        Json
  port             Int
  distPort         Int?
  /// False only after a confirmed stop (or, marked `heldUnknownSince`, an inactive owner's
  /// cancelled interactive stop). Offline/failed stops retain claims.
  claimHeld        Boolean            @default(true)
  /// New claims may be reserved behind this stopping instance, never dispatched before it releases.
  blockedBy        String[]           @default([])
  stoppedAt        DateTime?
  /// Set (with `claimHeld` false) when the claim was released WITHOUT proof that the service
  /// stopped: an inactive (banned or deletion-pending) owner's unanswerable interactive stop
  /// was cancelled so that account deletion is never blocked. Account and device deletion
  /// ignore it, but placement and execution budgets still count these resources and ports
  /// (no GPU double allocation) until a status check proves the service stopped (a
  /// status-first stop of the rank, or the CLI's verified `stopped` inventory), the
  /// instance retakes the claim, or the row goes with its device or owner.
  heldUnknownSince DateTime?
  Instance         DeploymentInstance @relation(fields: [instanceId], references: [id], onDelete: Restrict)
  CliDevice        CliDevice          @relation(fields: [cliDeviceId], references: [id], onDelete: Restrict)

  @@unique([instanceId, rank])
  @@index([cliDeviceId, claimHeld])
  @@map("deployment_instance_node")
}

model DeploymentStep {
  id                 String              @id @default(cuid(2))
  runId              String
  instanceId         String
  cliDeviceId        String
  rank               Int
  phase              String
  sequence           Int
  state              DeploymentStepState @default(PENDING)
  intent             Json
  intentHash         String
  attempts           Int                 @default(0)
  ownerEpoch         String?
  leaseExpiresAt     DateTime?
  deadline           DateTime?
  notBefore          DateTime?
  errorCode          String?
  /// Operator terminal of an interactive step (AWAITING_OPERATOR or RUNNING only); null once it
  /// closed. All operator columns are null while PENDING (schema-hardening.sql).
  operatorTerminalId String?
  /// When the operator terminal opened; required while AWAITING_OPERATOR.
  operatorSince      DateTime?
  /// When the person pressed Enter (the command started).
  operatorAcceptedAt DateTime?
  /// Exit code of the last command run in the operator terminal.
  operatorLastExit   Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @default(now()) @updatedAt
  Run                DeploymentRun       @relation(fields: [runId], references: [id], onDelete: Restrict)
  Instance           DeploymentInstance  @relation(fields: [instanceId], references: [id], onDelete: Restrict)

  @@unique([runId, instanceId, rank, phase, sequence])
  @@index([state, notBefore, leaseExpiresAt])
  @@map("deployment_step")
}

/// What happened to an operator terminal of an interactive deployment step. Metadata only:
/// never command text (the step intent holds it) or terminal output.
/// Plain id columns and NO foreign keys, on purpose (like CliAgentActionEvent): owner history
/// outside the user-deletion lock graph. A user delete drains the user's rows
/// (USER_PLAIN_ID_HISTORY_TABLES in packages/db/src/parent-deletion-residual.ts); a device or
/// instance delete keeps them. Until the orphan sweep and 90-day retention land (interactive
/// commands chunk 7/8, apps/server/src/model-api/usage-retention.ts), those rows stay until
/// their user is deleted. Append-only: schema-hardening.sql refuses updates.
model DeploymentOperatorEvent {
  id          String                    @id @default(cuid(2))
  createdAt   DateTime                  @default(now())
  userId      String
  instanceId  String
  stepId      String
  cliDeviceId String
  rank        Int
  /// The step intent's action: prepare, start, after_join or stop.
  action      String
  outcome     DeploymentOperatorOutcome
  exitCode    Int?

  @@index([userId, createdAt])
  @@index([instanceId, createdAt])
  @@index([createdAt])
  @@map("deployment_operator_event")
}
