enum CliConnectionStatus {
  DISCONNECTED
  CONNECTED
  STALE
  REVOKED
}

enum EndpointKind {
  OPENAI_COMPATIBLE
  ANTHROPIC_COMPATIBLE
}

enum ProviderAccountStatus {
  DISABLED
  ACTIVE
  DEGRADED
  UNAVAILABLE
}

enum ProviderAuthType {
  API_KEY
  BEARER
}

enum ExecutionTargetKind {
  DISCOVERED_MODEL
  PROVIDER_MODEL
}

enum EndpointStatus {
  UNKNOWN
  ONLINE
  DEGRADED
  OFFLINE
}

enum ModelCapability {
  TEXT_GENERATION
  VISION_INPUT
  /// Chat multimodal `video_url` (and similar) input — e.g. omni / VLM stacks.
  VIDEO_INPUT
  EMBEDDING
  AUDIO_INPUT
  AUDIO_OUTPUT
  RESPONSES_API
}

enum ModelCapabilityOverrideMode {
  INHERIT_ENDPOINT_DEFAULTS
  OVERRIDE
}

/// Who last authored a model capability override. Dashboard-authored overrides
/// are server-authoritative; CLI-authored ones remain editable via inventory.
enum ModelCapabilityOverrideOrigin {
  CLI
  DASHBOARD
}

enum PoolMemberHealthStatus {
  UNKNOWN
  HEALTHY
  HALF_OPEN
  DEGRADED
  UNHEALTHY
}

enum PoolMemberRoutingStatus {
  ACTIVE
  DRAINING
  DISABLED
}

enum PoolMemberFailureClass {
  TRANSPORT
  RELAY_TIMEOUT
  WEBSOCKET_DISCONNECTED
  STALE_SESSION
  UPSTREAM_5XX
}

enum ModelApiTokenScopeMode {
  ALL_VISIBLE
  ALLOWLIST
}

/// Whether pool media-transform descriptions may be cached (privacy-sensitive).
enum PoolTransformerCacheMode {
  /// Never store descriptions (privacy-first; more transform cost).
  OFF
  /// Process-local in-memory cache for cacheable media (data: URLs only).
  MEMORY
}

enum ModelApiTokenAllowlistTarget {
  DIRECT_MODEL
  MODEL_POOL
}

enum RelayRequestStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

model CliDevice {
  id                      String                @id @default(cuid(2))
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @default(now()) @updatedAt
  userId                  String
  slug                    String
  label                   String
  status                  CliConnectionStatus   @default(DISCONNECTED)
  lastConnectedAt         DateTime?
  lastDisconnectedAt      DateTime?
  lastHeartbeatAt         DateTime?
  connectionCount         Int                   @default(0)
  inventorySeq            Int                   @default(0)
  inventoryDigest         String?
  inventoryAcknowledgedAt DateTime?
  /// True only for a relay that negotiated complete-snapshot acknowledgements
  /// and endpoint targeting. Legacy 2.0 registration is visible but never
  /// represented as a confirmed published inventory.
  inventoryConfirmed      Boolean               @default(false)
  /// Whether this relay negotiated endpoint-targeted request frames. Legacy
  /// relays must never be allowed to replace their inventory with >1 endpoint.
  endpointTargeting       Boolean               @default(false)
  User                    User                  @relation("CliDeviceOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CliTokens               CliToken[]
  CliDeviceCredentials    CliDeviceCredential[]
  Endpoints               Endpoint[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@index([lastHeartbeatAt])
  @@map("cli_device")
}

model CliToken {
  id           String     @id @default(cuid(2))
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  userId       String
  cliDeviceId  String?
  name         String
  lookupPrefix String
  secretDigest String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  expiresAt    DateTime?
  User         User       @relation("CliTokenOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CliDevice    CliDevice? @relation(fields: [cliDeviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([lookupPrefix])
  @@unique([secretDigest])
  @@index([userId, revokedAt])
  @@index([cliDeviceId])
  @@index([expiresAt])
  @@map("cli_token")
}

model CliDeviceCredential {
  id           String     @id @default(cuid(2))
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @default(now()) @updatedAt
  userId       String
  cliDeviceId  String?
  name         String
  lookupPrefix String
  secretDigest String
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  User         User       @relation("CliDeviceCredentialOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CliDevice    CliDevice? @relation(fields: [cliDeviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([lookupPrefix])
  @@unique([secretDigest])
  @@index([userId, revokedAt])
  @@index([cliDeviceId])
  @@map("cli_device_credential")
}

model Endpoint {
  id                  String            @id @default(cuid(2))
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @default(now()) @updatedAt
  userId              String
  cliDeviceId         String
  slug                String
  label               String
  kind                EndpointKind      @default(OPENAI_COMPATIBLE)
  status              EndpointStatus    @default(UNKNOWN)
  defaultCapabilities ModelCapability[] @default([])
  capabilityMetadata  Json?
  probeSuggestions    Json?
  lastSeenAt          DateTime?
  lastHealthCheckAt   DateTime?
  statusChangedAt     DateTime?
  failureReasonCode   String?
  published           Boolean           @default(true)
  unpublishedAt       DateTime?
  User                User              @relation("EndpointOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  CliDevice           CliDevice         @relation(fields: [cliDeviceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  DiscoveredModels    DiscoveredModel[]

  @@unique([userId, slug])
  @@unique([cliDeviceId, slug])
  @@index([userId, status])
  @@index([cliDeviceId])
  @@index([kind, status])
  @@index([lastSeenAt])
  @@map("endpoint")
}

model DiscoveredModel {
  id                            String                         @id @default(cuid(2))
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @default(now()) @updatedAt
  userId                        String
  endpointId                    String
  slug                          String?
  upstreamModelId               String
  encodedModelId                String
  capabilityOverrideMode        ModelCapabilityOverrideMode    @default(INHERIT_ENDPOINT_DEFAULTS)
  capabilityOverrides           ModelCapability[]              @default([])
  capabilityOverrideMetadata    Json?
  capabilityOverrideOrigin      ModelCapabilityOverrideOrigin?
  /// Explicit opt-in for basic, non-streaming transcription when support is unknown.
  optimisticBasicTranscription  Boolean                        @default(false)
  /// Optional per-model attachment cap. Null inherits the global attachment cap.
  maxAttachmentBytes            Int?
  probeSuggestions              Json?
  lastSeenAt                    DateTime?
  published                     Boolean                        @default(true)
  unpublishedAt                 DateTime?
  User                          User                           @relation("DiscoveredModelOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Endpoint                      Endpoint                       @relation(fields: [endpointId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  PoolMembers                   PoolMember[]
  TransformerForPools           ModelPool[]                    @relation("ModelPoolTransformer")
  ModelApiTokenAllowlistEntries ModelApiTokenAllowlistEntry[]
  ResponseStickinessTargets     ResponseStickinessRecord[]     @relation("ResponseStickinessTargetModel")
  ResponseStickinessSelections  ResponseStickinessRecord[]     @relation("ResponseStickinessSelectedModel")
  RequestedRelayRequests        RelayRequest[]                 @relation("RelayRequestRequestedModel")
  SelectedRelayRequests         RelayRequest[]                 @relation("RelayRequestSelectedModel")
  ExecutionTarget               ExecutionTarget?

  @@unique([endpointId, upstreamModelId])
  @@unique([endpointId, encodedModelId])
  @@unique([id, userId])
  @@index([userId])
  @@index([endpointId, slug])
  @@index([endpointId, lastSeenAt])
  @@map("discovered_model")
}

/// Dormant reusable public-provider configuration. Management APIs and egress
/// remain feature-gated until credential, SSRF, admission, and budget controls
/// are implemented.
model ProviderAccount {
  id                String                @id @default(cuid(2))
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @default(now()) @updatedAt
  userId            String
  providerType      String
  label             String
  baseUrl           String
  authType          ProviderAuthType
  status            ProviderAccountStatus @default(DISABLED)
  enabled           Boolean               @default(false)
  safeConfiguration Json?
  User              User                  @relation("ProviderAccountOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ProviderModels    ProviderModel[]

  @@unique([userId, label])
  @@unique([id, userId])
  @@index([userId, status])
  @@map("provider_account")
}

model ProviderModel {
  id                 String           @id @default(cuid(2))
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @default(now()) @updatedAt
  userId             String
  providerAccountId  String
  upstreamModelId    String
  displayName        String?
  capabilityMetadata Json?
  enabled            Boolean          @default(false)
  User               User             @relation("ProviderModelOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ProviderAccount    ProviderAccount  @relation(fields: [providerAccountId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  ExecutionTarget    ExecutionTarget?

  @@unique([providerAccountId, upstreamModelId])
  @@unique([id, userId])
  @@index([userId])
  @@index([providerAccountId, enabled])
  @@map("provider_model")
}

/// Stable, owner-scoped identity for anything capable of executing inference.
/// The named database CHECK installed by prisma/schema-hardening.sql enforces the
/// kind/FK XOR that Prisma cannot express.
model ExecutionTarget {
  id                     String                        @id @default(cuid(2))
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @default(now()) @updatedAt
  userId                 String
  kind                   ExecutionTargetKind
  discoveredModelId      String?                       @unique
  providerModelId        String?                       @unique
  User                   User                          @relation("ExecutionTargetOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  DiscoveredModel        DiscoveredModel?              @relation(fields: [discoveredModelId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  ProviderModel          ProviderModel?                @relation(fields: [providerModelId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  PoolMembers            PoolMember[]
  TokenAllowlistEntries  ModelApiTokenAllowlistEntry[]
  StickinessTargets      ResponseStickinessRecord[]    @relation("ResponseStickinessTargetExecutionTarget")
  StickinessSelections   ResponseStickinessRecord[]    @relation("ResponseStickinessSelectedExecutionTarget")
  RequestedRelayRequests RelayRequest[]                @relation("RelayRequestRequestedExecutionTarget")
  SelectedRelayRequests  RelayRequest[]                @relation("RelayRequestSelectedExecutionTarget")

  @@unique([discoveredModelId, userId])
  @@unique([providerModelId, userId])
  @@index([userId, kind])
  @@map("execution_target")
}

model ModelPool {
  id                             String                        @id @default(cuid(2))
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @default(now()) @updatedAt
  userId                         String
  slug                           String
  name                           String
  description                    String?
  /// Optional OpenAI-compatible model used to turn media into text before the
  /// primary pool members run. Null = transformer disabled (default).
  transformerDiscoveredModelId   String?
  /// Free-text system prompt for the transformer call. Null = built-in default.
  transformerSystemPrompt        String?
  /// When true (default if transformer set), image_url parts are transformed.
  transformerImages              Boolean                       @default(true)
  /// When true, input_audio / audio parts are transformed (v1 may no-op if unsupported).
  transformerAudio               Boolean                       @default(false)
  /// When true, video_url parts are transformed.
  transformerVideo               Boolean                       @default(false)
  /// Description cache policy. Default OFF so screenshot/PII text is not retained.
  transformerCacheMode           PoolTransformerCacheMode      @default(OFF)
  /// When true, inject a size-capped name+description list of the primary request's tools.
  transformerIncludePrimaryTools Boolean                       @default(false)
  transformerMaxTools            Int                           @default(32)
  transformerMaxToolChars        Int                           @default(8000)
  /// Per-hop transformer timeout. Null uses the server default.
  transformerTimeoutMs           Int?
  /// Max media parts across all transform jobs in one request. Null uses the server default.
  transformerMaxAssets           Int?
  /// Optional per-pool attachment cap. Null inherits the global attachment cap.
  maxAttachmentBytes             Int?
  /// Permit unknown-capability members only as fallback for basic, non-streaming transcription.
  optimisticBasicTranscription   Boolean                       @default(false)
  User                           User                          @relation("ModelPoolOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  TransformerDiscoveredModel     DiscoveredModel?              @relation("ModelPoolTransformer", fields: [transformerDiscoveredModelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  PoolMembers                    PoolMember[]
  PoolGrants                     PoolGrant[]
  ModelApiTokenAllowlistEntries  ModelApiTokenAllowlistEntry[]
  ResponseStickinessRecords      ResponseStickinessRecord[]
  RelayRequests                  RelayRequest[]                @relation("RelayRequestRequestedPool")

  @@unique([userId, slug])
  @@index([userId])
  @@index([transformerDiscoveredModelId])
  @@map("model_pool")
}

model PoolMember {
  id                           String                  @id @default(cuid(2))
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @default(now()) @updatedAt
  poolId                       String
  discoveredModelId            String?
  executionTargetId            String?
  weight                       Int                     @default(1)
  healthStatus                 PoolMemberHealthStatus  @default(UNKNOWN)
  routingStatus                PoolMemberRoutingStatus @default(ACTIVE)
  lastFailureClass             PoolMemberFailureClass?
  consecutiveRetryableFailures Int                     @default(0)
  lastFailureAt                DateTime?
  nextRetryAt                  DateTime?
  halfOpenTrialStartedAt       DateTime?
  lastRoutedAt                 DateTime?
  ModelPool                    ModelPool               @relation(fields: [poolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  DiscoveredModel              DiscoveredModel?        @relation(fields: [discoveredModelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ExecutionTarget              ExecutionTarget?        @relation(fields: [executionTargetId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([poolId, discoveredModelId])
  @@unique([poolId, executionTargetId])
  @@index([discoveredModelId])
  @@index([executionTargetId])
  @@index([poolId, routingStatus, healthStatus])
  @@index([healthStatus, nextRetryAt])
  @@map("pool_member")
}

model PoolGrant {
  id            String    @id @default(cuid(2))
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  poolId        String
  ownerUserId   String
  granteeUserId String
  ModelPool     ModelPool @relation(fields: [poolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Owner         User      @relation("PoolGrantOwner", fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Grantee       User      @relation("PoolGrantGrantee", fields: [granteeUserId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([poolId, granteeUserId])
  @@index([ownerUserId])
  @@index([granteeUserId])
  @@map("pool_grant")
}

model ModelApiToken {
  id                        String                        @id @default(cuid(2))
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @default(now()) @updatedAt
  userId                    String
  name                      String
  scopeMode                 ModelApiTokenScopeMode        @default(ALL_VISIBLE)
  lookupPrefix              String
  secretDigest              String
  lastUsedAt                DateTime?
  revokedAt                 DateTime?
  expiresAt                 DateTime?
  User                      User                          @relation("ModelApiTokenOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  AllowlistEntries          ModelApiTokenAllowlistEntry[]
  RelayRequests             RelayRequest[]
  ResponseStickinessRecords ResponseStickinessRecord[]

  @@unique([lookupPrefix])
  @@unique([secretDigest])
  @@index([userId, revokedAt])
  @@index([scopeMode])
  @@index([expiresAt])
  @@map("model_api_token")
}

model ModelApiTokenAllowlistEntry {
  id                String                       @id @default(cuid(2))
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @default(now()) @updatedAt
  modelApiTokenId   String
  target            ModelApiTokenAllowlistTarget
  discoveredModelId String?
  executionTargetId String?
  modelPoolId       String?
  ModelApiToken     ModelApiToken                @relation(fields: [modelApiTokenId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  DiscoveredModel   DiscoveredModel?             @relation(fields: [discoveredModelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ExecutionTarget   ExecutionTarget?             @relation(fields: [executionTargetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ModelPool         ModelPool?                   @relation(fields: [modelPoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([modelApiTokenId, discoveredModelId])
  @@unique([modelApiTokenId, executionTargetId])
  @@unique([modelApiTokenId, modelPoolId])
  @@index([discoveredModelId])
  @@index([executionTargetId])
  @@index([modelPoolId])
  @@index([modelApiTokenId, target])
  @@map("model_api_token_allowlist_entry")
}

model ResponseStickinessRecord {
  id                        String           @id @default(cuid(2))
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @default(now()) @updatedAt
  userId                    String
  modelApiTokenId           String?
  routingKeyDigest          String
  targetDiscoveredModelId   String?
  targetModelPoolId         String?
  selectedDiscoveredModelId String?
  targetExecutionTargetId   String?
  selectedExecutionTargetId String?
  expiresAt                 DateTime?
  User                      User             @relation("ResponseStickinessOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ModelApiToken             ModelApiToken?   @relation(fields: [modelApiTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  TargetDiscoveredModel     DiscoveredModel? @relation("ResponseStickinessTargetModel", fields: [targetDiscoveredModelId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  TargetModelPool           ModelPool?       @relation(fields: [targetModelPoolId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  SelectedDiscoveredModel   DiscoveredModel? @relation("ResponseStickinessSelectedModel", fields: [selectedDiscoveredModelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  TargetExecutionTarget     ExecutionTarget? @relation("ResponseStickinessTargetExecutionTarget", fields: [targetExecutionTargetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  SelectedExecutionTarget   ExecutionTarget? @relation("ResponseStickinessSelectedExecutionTarget", fields: [selectedExecutionTargetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([userId, routingKeyDigest])
  @@index([modelApiTokenId])
  @@index([targetDiscoveredModelId])
  @@index([targetModelPoolId])
  @@index([selectedDiscoveredModelId])
  @@index([targetExecutionTargetId])
  @@index([selectedExecutionTargetId])
  @@index([expiresAt])
  @@map("response_stickiness_record")
}

model RelayRequest {
  id                         String             @id @default(cuid(2))
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @default(now()) @updatedAt
  userId                     String
  modelApiTokenId            String?
  modelApiTokenLookupPrefix  String?
  requestedDiscoveredModelId String?
  requestedModelPoolId       String?
  selectedDiscoveredModelId  String?
  requestedExecutionTargetId String?
  selectedExecutionTargetId  String?
  status                     RelayRequestStatus @default(PENDING)
  startedAt                  DateTime           @default(now())
  completedAt                DateTime?
  durationMs                 Int?
  promptTokens               Int?
  completionTokens           Int?
  totalTokens                Int?
  httpStatusCode             Int?
  upstreamStatusCode         Int?
  errorClass                 String?
  transformerLatencyMs       Int?
  transformerCacheHit        Boolean?
  transformerErrorClass      String?
  /// Protocol operation only; never stores prompts, filenames, audio, or transcripts.
  operation                  String?
  /// Sum of rebuilt upstream request-body bytes across all relay attempts.
  /// Includes multipart boundaries/headers; it is not the source audio size.
  requestBytes               BigInt?
  /// Sum of upstream response-body bytes received across all relay attempts,
  /// including retryable failed attempts, counted without retaining content.
  responseBytes              BigInt?
  /// Number of upstream relay attempts (greater than one indicates pool retry).
  attemptCount               Int                @default(0)
  User                       User               @relation("RelayRequestOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ModelApiToken              ModelApiToken?     @relation(fields: [modelApiTokenId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  RequestedDiscoveredModel   DiscoveredModel?   @relation("RelayRequestRequestedModel", fields: [requestedDiscoveredModelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  RequestedModelPool         ModelPool?         @relation("RelayRequestRequestedPool", fields: [requestedModelPoolId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  SelectedDiscoveredModel    DiscoveredModel?   @relation("RelayRequestSelectedModel", fields: [selectedDiscoveredModelId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  RequestedExecutionTarget   ExecutionTarget?   @relation("RelayRequestRequestedExecutionTarget", fields: [requestedExecutionTargetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  SelectedExecutionTarget    ExecutionTarget?   @relation("RelayRequestSelectedExecutionTarget", fields: [selectedExecutionTargetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([modelApiTokenId, createdAt])
  @@index([requestedDiscoveredModelId, createdAt])
  @@index([requestedModelPoolId, createdAt])
  @@index([selectedDiscoveredModelId])
  @@index([requestedExecutionTargetId, createdAt])
  @@index([selectedExecutionTargetId])
  @@index([status, createdAt])
  @@map("relay_request")
}

model MediaAsset {
  // Metadata ONLY — bytes live in the MediaStore (local volume / future S3),
  // never in Postgres. Rows are ephemeral: a TTL sweep and lazy-on-GET delete
  // remove expired assets. See apps/server/src/media/.
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  userId    String
  mime      String
  sizeBytes Int
  sha256    String
  expiresAt DateTime
  User      User     @relation("MediaAssetOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@index([userId, sha256])
  @@map("media_asset")
}
