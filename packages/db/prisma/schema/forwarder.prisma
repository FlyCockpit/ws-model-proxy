/// Append-only, prompt-free facts for each local CLI relay attempt. A separate
/// row per lifecycle transition preserves retries and crash-repair history.
model RelayExecutionEvent {
  id                     String       @id @default(cuid(2))
  createdAt              DateTime     @default(now())
  userId                 String
  relayRequestId         String
  attemptId              String
  eventType              String
  attemptKind            String       @default("EXECUTION")
  requestedSurface       String
  nativeSurface          String?
  adapterMode            String?
  adapterVersion         String?
  poolId                 String?
  poolMemberId           String?
  executionTargetId      String?
  memberTier             String?
  contextCountMethod     String?
  contextCountConfidence String?
  contextTokens          Int?
  admissionAttemptId     String?
  admissionLeaseId       String?
  admissionFencingToken  BigInt?
  waitDurationMs         Int?
  streamCommitted        Boolean      @default(false)
  terminalState          String?
  httpStatusCode         Int?
  upstreamStatusCode     Int?
  errorClass             String?
  promptTokens           Int?
  completionTokens       Int?
  totalTokens            Int?
  usageSource            String?
  RelayRequest           RelayRequest @relation(fields: [relayRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([attemptId, eventType])
  @@index([userId, createdAt])
  @@index([relayRequestId, createdAt])
  @@map("relay_execution_event")
}

/// Mutable fenced ownership for one local CLI attempt. History remains in
/// RelayExecutionEvent; this row exists only to make liveness and crash repair safe.
model RelayExecutionAttempt {
  attemptId         String       @id
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt
  userId            String
  relayRequestId    String
  ownerEpoch        String
  heartbeatAt       DateTime     @default(now())
  expiresAt         DateTime
  state             String       @default("ACTIVE")
  attemptKind       String       @default("EXECUTION")
  terminalAt        DateTime?
  terminalState     String?
  requestedSurface  String
  nativeSurface     String?
  adapterMode       String?
  adapterVersion    String?
  poolId            String?
  poolMemberId      String?
  executionTargetId String?
  memberTier        String?
  requestBytes      BigInt?
  responseBytes     BigInt?
  RelayRequest      RelayRequest @relation(fields: [relayRequestId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([state, expiresAt])
  @@index([ownerEpoch, state])
  @@index([relayRequestId, createdAt])
  // Owner lookups (deleted-user purge checks).
  @@index([userId])
  @@map("relay_execution_attempt")
}

/// Prompt-free, owner-scoped history of capacity and admission-policy changes.
model CapacityAuditEvent {
  id           String   @id @default(cuid(2))
  createdAt    DateTime @default(now())
  userId       String
  actorUserId  String
  action       String
  resourceType String
  resourceId   String
  before       Json?
  after        Json?
  User         User     @relation("CapacityAuditEventOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("capacity_audit_event")
}

model MediaAsset {
  // Metadata ONLY — bytes live in the MediaStore (local volume / future S3),
  // never in Postgres. Rows are ephemeral: a TTL sweep and lazy-on-GET delete
  // remove expired assets. See apps/server/src/media/.
  id        String   @id @default(cuid(2))
  createdAt DateTime @default(now())
  userId    String
  mime      String
  sizeBytes Int
  sha256    String
  expiresAt DateTime
  User      User     @relation("MediaAssetOwner", fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([expiresAt])
  @@index([userId, sha256])
  @@map("media_asset")
}

/// Grantee-only own-key choice. The exact grant tuple prevents substitution;
/// deletion of the grant or provider model removes the preference atomically.
model PoolFallbackPreference {
  protocolAdaptationEnabled Boolean       @default(false)
  id                        String        @id @default(cuid(2))
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @default(now()) @updatedAt
  userId                    String
  poolId                    String
  poolGrantId               String
  providerModelId           String
  PoolGrant                 PoolGrant     @relation(fields: [poolGrantId, poolId, userId], references: [id, poolId, granteeUserId], onDelete: Cascade, onUpdate: Cascade)
  ProviderModel             ProviderModel @relation(fields: [providerModelId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([poolId, userId])
  @@index([poolGrantId, poolId, userId])
  @@index([providerModelId, userId])
  @@index([userId])
  @@map("pool_fallback_preference")
}
