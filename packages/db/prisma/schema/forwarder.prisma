model RelayRequest {
  id                         String                  @id @default(cuid(2))
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @default(now()) @updatedAt
  userId                     String
  modelApiTokenId            String?
  modelApiTokenLookupPrefix  String?
  requestedDiscoveredModelId String?
  requestedModelPoolId       String?
  selectedDiscoveredModelId  String?
  requestedExecutionTargetId String?
  selectedExecutionTargetId  String?
  status                     RelayRequestStatus      @default(PENDING)
  source                     RelayRequestSource      @default(API_TOKEN)
  startedAt                  DateTime                @default(now())
  completedAt                DateTime?
  durationMs                 Int?
  /// Total prompt tokens (uncached + cache reads + cache writes) as parsed
  /// server-side from the upstream response usage. Counts only, never content.
  promptTokens               Int?
  completionTokens           Int?
  totalTokens                Int?
  /// Prompt tokens served from the engine prompt cache. Null = not reported.
  cacheReadTokens            Int?
  /// Prompt tokens written to the engine prompt cache. Null = not reported.
  cacheWriteTokens           Int?
  /// True when the upstream response reported token usage for this request.
  usageKnown                 Boolean                 @default(false)
  httpStatusCode             Int?
  upstreamStatusCode         Int?
  errorClass                 String?
  transformerLatencyMs       Int?
  transformerCacheHit        Boolean?
  transformerErrorClass      String?
  /// Prompt-free protocol routing facts. These fields contain only bounded
  /// identifiers/enums and never request content, tool arguments, media, or headers.
  requestedSurface           String?
  selectedNativeSurface      String?
  adapterMode                String?
  adapterVersion             String?
  selectedPoolMemberId       String?
  localAttemptId             String?
  firstClientByteAt          DateTime?
  /// Prompt-free context admission telemetry. Never stores request content.
  contextTokenCount          Int?
  contextCountMethod         String?
  contextCountConfidence     String?
  contextCountExact          Boolean?
  contextSafetyMargin        Float?
  contextSerializedChars     Int?
  /// Prompt-free global admission correlation and outcome telemetry.
  admissionAttemptId         String?
  admissionLeaseId           String?
  admissionCapacityId        String?
  admissionFencingToken      BigInt?
  admissionWaitDurationMs    Int?
  admissionReservationClass  Int?
  admissionBorrowed          Boolean?
  admissionTerminalState     String?
  /// Prompt-free public overflow correlation and commitment telemetry.
  publicEgress               Boolean                 @default(false)
  publicOverflowReason       String?
  /// Prompt-free route that served or finally failed: "local", "pool-external", or "own-key".
  /// Pending own-key rows persist send intent immediately before provider I/O;
  /// abandoned tiers restore the prior route and target before any continuation.
  /// Null for requests that never reached a pool route decision.
  fallbackRoute              String?
  selectedPoolMemberTier     String?
  providerAccountId          String?
  providerModelId            String?
  providerAttemptId          String?
  providerFencingToken       BigInt?
  streamCommitted            Boolean                 @default(false)
  affinityOutcome            String?
  affinityScore              Int?
  affinityPrefixDepth        Int?
  affinityReason             String?
  /// Milliseconds the local admission held the request for the cache-holder
  /// member (spill-over window applied); null when no window applied.
  affinityWaitMs             Int?
  /// Protocol operation only; never stores prompts, filenames, audio, or transcripts.
  operation                  String?
  /// Sum of rebuilt upstream request-body bytes across all relay attempts.
  /// Includes multipart boundaries/headers; it is not the source audio size.
  requestBytes               BigInt?
  /// Sum of upstream response-body bytes received across all relay attempts,
  /// including retryable failed attempts, counted without retaining content.
  responseBytes              BigInt?
  /// Number of upstream relay attempts (greater than one indicates pool retry).
  attemptCount               Int                     @default(0)
  auxiliaryAttemptCount      Int                     @default(0)
  auxiliaryRequestBytes      BigInt                  @default(0)
  auxiliaryResponseBytes     BigInt                  @default(0)
  /// Durable owner of the requested resource, for usage attribution: the
  /// requested pool's owner, else the requester. Derived by the database at
  /// insert (schema-hardening.sql, derive_relay_request_resource_owner) and
  /// immutable afterwards, so it survives the pool's deletion. Deliberately a
  /// plain id, not a foreign key: readers tolerate a deleted owner.
  resourceOwnerUserId        String?
  AdmissionRequests          AdmissionRequest[]
  ExecutionEvents            RelayExecutionEvent[]
  ExecutionAttempts          RelayExecutionAttempt[]

  // The user-deletion drain's keyset scan (packages/db/src/parent-deletion.ts:
  // WHERE "userId" = $1 AND ("createdAt", id) > ... ORDER BY "createdAt", id)
  // and the owner's history reads.
  @@index([userId, createdAt, id])
  @@index([modelApiTokenId, createdAt])
  @@index([requestedDiscoveredModelId, createdAt])
  @@index([requestedModelPoolId, createdAt])
  @@index([selectedDiscoveredModelId])
  @@index([selectedPoolMemberId])
  @@index([requestedExecutionTargetId, createdAt])
  // Prefill-speed estimator: the latest rows served by one execution target.
  @@index([selectedExecutionTargetId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@map("relay_request")
}

/// Prompt-free per-minute usage aggregates for dashboard metrics. Exactly one
/// increment per relay request, written in the same transaction as the
/// request's PENDING -> terminal transition. Optional identities use the ''
/// sentinel (never NULL) so the composite primary key is a real conflict
/// target: PostgreSQL treats NULLs as distinct in unique indexes, which would
/// make ON CONFLICT never merge.
/// Users: own-key rows use the requester as `ownerUserId`, with empty pool/member
/// keys. Otherwise `ownerUserId` is the RESOURCE owner (requested pool's owner, else
/// the execution target's owner, else the requester when nothing resolved);
/// owners see all traffic on what they own. Rollups are hot-path history
/// (DL-1 writer class H): neither user column is a foreign key. Deleting the
/// owner erases their rows (user drain, then the deleted-user purge,
/// @ws-model-proxy/db/hot-path-sweeps); deleting a requester must not erase
/// the owner's history, so the drain and the purge merge the deleted
/// requester's rows into the '' sentinel requester. Grantees read only rows
/// where they are the requester and not the owner.
/// Latency histograms use the fixed log-scale bounds in
/// `@ws-model-proxy/config/usage-metrics`. Kept 30 days, then compacted into
/// UsageRollupHour.
model UsageRollupMinute {
  bucketStart                 DateTime
  ownerUserId                 String
  /// '' once the requester was deleted (merged by the drain/purge); never NULL.
  requesterUserId             String
  poolId                      String             @default("")
  poolMemberId                String             @default("")
  executionTargetId           String             @default("")
  source                      RelayRequestSource
  updatedAt                   DateTime           @default(now())
  requests                    Int                @default(0)
  successes                   Int                @default(0)
  errors                      Int                @default(0)
  cancels                     Int                @default(0)
  retries                     Int                @default(0)
  usageKnownRequests          Int                @default(0)
  inputTokens                 BigInt             @default(0)
  outputTokens                BigInt             @default(0)
  cacheReadTokens             BigInt             @default(0)
  cacheWriteTokens            BigInt             @default(0)
  /// Requests whose upstream reported cache usage, and their prompt tokens:
  /// the denominator of the token-weighted prompt-cache hit rate.
  cacheKnownRequests          Int                @default(0)
  cacheKnownInputTokens       BigInt             @default(0)
  /// Matched-affinity requests that also reported cache fields (continuation
  /// split). Older buckets stay 0, so continuationHitRate is null until data lands.
  continuationRequests        Int                @default(0)
  continuationInputTokens     BigInt             @default(0)
  continuationCacheReadTokens BigInt             @default(0)
  durationCount               Int                @default(0)
  durationSumMs               BigInt             @default(0)
  latencyHistogram            Int[]              @default([])
  ttftCount                   Int                @default(0)
  ttftSumMs                   BigInt             @default(0)
  ttftHistogram               Int[]              @default([])

  @@id([bucketStart, ownerUserId, requesterUserId, poolId, poolMemberId, executionTargetId, source])
  @@index([ownerUserId, bucketStart])
  @@index([requesterUserId, bucketStart])
  @@map("usage_rollup_minute")
}

/// Hourly compaction of UsageRollupMinute (same key, own-key owner semantics and counters), kept 13
/// months. Rows are only written by the retention compaction job.
model UsageRollupHour {
  bucketStart                 DateTime
  ownerUserId                 String
  /// '' once the requester was deleted (merged by the drain/purge); never NULL.
  requesterUserId             String
  poolId                      String             @default("")
  poolMemberId                String             @default("")
  executionTargetId           String             @default("")
  source                      RelayRequestSource
  updatedAt                   DateTime           @default(now())
  requests                    Int                @default(0)
  successes                   Int                @default(0)
  errors                      Int                @default(0)
  cancels                     Int                @default(0)
  retries                     Int                @default(0)
  usageKnownRequests          Int                @default(0)
  inputTokens                 BigInt             @default(0)
  outputTokens                BigInt             @default(0)
  cacheReadTokens             BigInt             @default(0)
  cacheWriteTokens            BigInt             @default(0)
  cacheKnownRequests          Int                @default(0)
  cacheKnownInputTokens       BigInt             @default(0)
  continuationRequests        Int                @default(0)
  continuationInputTokens     BigInt             @default(0)
  continuationCacheReadTokens BigInt             @default(0)
  durationCount               Int                @default(0)
  durationSumMs               BigInt             @default(0)
  latencyHistogram            Int[]              @default([])
  ttftCount                   Int                @default(0)
  ttftSumMs                   BigInt             @default(0)
  ttftHistogram               Int[]              @default([])

  @@id([bucketStart, ownerUserId, requesterUserId, poolId, poolMemberId, executionTargetId, source])
  @@index([ownerUserId, bucketStart])
  @@index([requesterUserId, bucketStart])
  @@map("usage_rollup_hour")
}

