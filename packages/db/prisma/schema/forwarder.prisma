  DEGRADED
  OFFLINE
}

enum ModelCapability {
  TEXT_GENERATION
  VISION_INPUT
  /// Chat multimodal `video_url` (and similar) input — e.g. omni / VLM stacks.
  VIDEO_INPUT
  EMBEDDING
  AUDIO_INPUT
  AUDIO_OUTPUT
  RESPONSES_API
}

enum ModelCapabilityOverrideMode {
  INHERIT_ENDPOINT_DEFAULTS
  OVERRIDE
}

/// Who last authored a model capability override. Dashboard-authored overrides
/// are server-authoritative; CLI-authored ones remain editable via inventory.
