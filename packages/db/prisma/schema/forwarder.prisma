  ACCOUNT_UPDATED
  ACCOUNT_DELETED
  MODEL_CREATED
  MODEL_UPDATED
  MODEL_DELETED
  CREDENTIAL_CREATED
  CREDENTIAL_REPLACED
  CREDENTIAL_REVOKED
  CREDENTIAL_ROTATED
