// ───────────────────────────── Providers and spend ─────────────────────────────
// Every write here is human-only (cloud spend and provider keys).

enum ProviderAuthType {
  API_KEY
  BEARER
}

enum ProviderCredentialStatus {
  ACTIVE
  REPLACED
  REVOKED
}

enum ProviderHealth {
  UNKNOWN
  HEALTHY
  DEGRADED
  UNAVAILABLE
}

enum ProviderPricingStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum UsageCostConfidence {
  REPORTED
  CALCULATED
  ESTIMATED
}

enum AccountingRevisionKind {
  SNAPSHOT
  DELTA
}

/// A cloud account (OpenRouter or a generic OpenAI/Anthropic-compatible URL). `enabled` is the
/// only on/off; health is the circuit below (the old status enum is gone).
model ProviderAccount {
  id                         String           @id @default(cuid(2))
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @default(now()) @updatedAt
  deletedAt                  DateTime?
  userId                     String
  /// "openrouter" | "generic" (zod; provider-type.ts).
  providerType               String
  providerVersion            String?
  label                      String
  baseUrl                    String
  endpointIdentity           String           @default("")
  endpointVersion            Int              @default(1)
  authType                   ProviderAuthType
  enabled                    Boolean          @default(false)
  safeConfiguration          Json?
  /// OpenRouter: when false every request carries data_collection: deny.
  allowDataCollection        Boolean          @default(false)
  currentCredentialId        String?          @unique
  health                     ProviderHealth   @default(UNKNOWN)
  healthCheckedAt            DateTime?
  healthFailureCount         Int              @default(0)
  healthNextRetryAt          DateTime?
  healthHalfOpenAt           DateTime?
  healthHalfOpenAttemptId    String?
  healthHalfOpenFencingToken BigInt?
  healthFencingWatermark     BigInt           @default(0)
  nextFencingToken           BigInt           @default(0)

  User              User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Models            ProviderModel[]
  Credentials       ProviderCredential[]     @relation("ProviderAccountCredentials")
  CurrentCredential ProviderCredential?      @relation("ProviderAccountCurrentCredential", fields: [currentCredentialId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  PricingVersions   ProviderPricingVersion[]
  SpendCap          SpendCap?

  @@unique([userId, label])
  @@unique([id, userId])
  @@unique([id, userId, endpointVersion])
  @@map("provider_account")
}

model ProviderModel {
  id                         String         @id @default(cuid(2))
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @default(now()) @updatedAt
  deletedAt                  DateTime?
  userId                     String
  providerAccountId          String
  upstreamModelId            String
  displayName                String?
  type                       ModelType
  capabilityMetadata         Json?
  nativeCapabilities         Json?
  contextWindow              Int?
  maxOutputTokens            Int?
  pricingMetadata            Json?
  enabled                    Boolean        @default(false)
  health                     ProviderHealth @default(UNKNOWN)
  healthCheckedAt            DateTime?
  healthFailureCount         Int            @default(0)
  healthNextRetryAt          DateTime?
  healthHalfOpenAt           DateTime?
  healthHalfOpenAttemptId    String?
  healthHalfOpenFencingToken BigInt?
  healthFencingWatermark     BigInt         @default(0)

  User            User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Account         ProviderAccount          @relation(fields: [providerAccountId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  Target          ExecutionTarget?
  Members         PoolMember[]
  PricingVersions ProviderPricingVersion[]
  OwnKeyShares    Share[]

  @@unique([providerAccountId, upstreamModelId])
  @@unique([id, userId])
  @@index([userId])
  @@map("provider_model")
}

/// AES-256-GCM provider secret; identity fields are the AAD and immutable.
model ProviderCredential {
  id                String                   @id @default(cuid(2))
  createdAt         DateTime                 @default(now())
  userId            String
  providerAccountId String
  credentialType    ProviderAuthType
  aadVersion        Int                      @default(1)
  algorithm         String                   @default("AES-256-GCM")
  keyVersion        String
  ciphertext        Bytes
  nonce             Bytes
  authTag           Bytes
  displaySuffix     String
  status            ProviderCredentialStatus @default(ACTIVE)
  replacedAt        DateTime?
  replacedById      String?                  @unique
  lastUsedAt        DateTime?
  revokedAt         DateTime?

  User              User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Account           ProviderAccount     @relation("ProviderAccountCredentials", fields: [providerAccountId, userId], references: [id, userId], onDelete: Cascade, onUpdate: Cascade)
  CurrentForAccount ProviderAccount?    @relation("ProviderAccountCurrentCredential")
  ReplacedBy        ProviderCredential? @relation("ProviderCredentialReplacement", fields: [replacedById, userId], references: [id, userId], onDelete: NoAction, onUpdate: Cascade)
  Replaces          ProviderCredential? @relation("ProviderCredentialReplacement")

  @@unique([id, userId])
  @@unique([replacedById, userId])
  @@unique([nonce, keyVersion])
  @@index([providerAccountId, status])
  @@map("provider_credential")
}

/// Immutable price schedule referenced by ledger rows via version.
model ProviderPricingVersion {
  id                String                @id @default(cuid(2))
  createdAt         DateTime              @default(now())
  userId            String
  providerAccountId String
  providerModelId   String
  version           String
  currency          String
  status            ProviderPricingStatus @default(ACTIVE)
  accountingVersion String                @default("provider-billable-v1")
  confidence        UsageCostConfidence   @default(ESTIMATED)
  pricing           Json
  chargeRules       Json                  @default("{}")
  effectiveAt       DateTime
  activatedAt       DateTime?             @default(now())
  retiredAt         DateTime?

  Account ProviderAccount @relation(fields: [providerAccountId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Cascade)
  Model   ProviderModel   @relation(fields: [providerModelId, userId], references: [id, userId], onDelete: NoAction, onUpdate: Cascade)

  @@unique([providerModelId, version])
  @@index([providerModelId, status, effectiveAt, retiredAt])
  @@map("provider_pricing_version")
}

enum SpendCapScope {
  /// Everything spent through one provider account (any pool, any caller).
  PROVIDER_ACCOUNT
  /// What one share holder may spend of the pool owner's money via `:external`.
  SHARE
}

/// A monthly (UTC calendar month) spend cap. Replaces ProviderBudgetPolicy + Rule (scopes,
/// metrics and periods collapse to one money cap). `version` increments on every limit change
/// and is snapshotted by reservations.
model SpendCap {
  id                String        @id @default(cuid(2))
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  userId            String
  scope             SpendCapScope
  providerAccountId String?       @unique
  shareId           String?       @unique
  monthlyLimit      Decimal       @db.Decimal(30, 9)
  currency          String        @default("USD")
  version           Int           @default(1)

  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ProviderAccount ProviderAccount? @relation(fields: [providerAccountId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  Share           Share?           @relation(fields: [shareId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@map("spend_cap")
}

enum ReservationState {
  RESERVED
  SETTLED
}

/// Fenced liability hold for one cloud attempt against one cap (hot path, no graph FKs).
model SpendReservation {
  id            String           @id @default(cuid(2))
  createdAt     DateTime         @default(now())
  settledAt     DateTime?
  expiresAt     DateTime
  userId        String
  capId         String
  capVersion    Int
  requestId     String
  attemptId     String
  fencingToken  BigInt
  windowStart   DateTime
  windowEnd     DateTime
  reservedValue Decimal          @db.Decimal(30, 9)
  settledValue  Decimal?         @db.Decimal(30, 9)
  currency      String
  state         ReservationState @default(RESERVED)

  Settlements SpendSettlement[]

  @@unique([capId, attemptId])
  @@unique([id, userId])
  @@index([userId, state, expiresAt])
  @@index([capId, windowStart, windowEnd])
  @@map("spend_reservation")
}

/// Append-only reconciliation; the fencing identity makes retries idempotent.
model SpendSettlement {
  id               String                 @id @default(cuid(2))
  createdAt        DateTime               @default(now())
  userId           String
  reservationId    String
  attemptId        String
  fencingToken     BigInt
  sourceVersion    String                 @default("terminal-v1")
  revisionSequence BigInt                 @default(1)
  revisionKind     AccountingRevisionKind @default(SNAPSHOT)
  payloadHash      String
  pricingVersion   String?
  settledValue     Decimal                @db.Decimal(30, 9)
  currency         String?
  confidence       UsageCostConfidence
  reason           String

  Reservation SpendReservation @relation(fields: [reservationId, userId], references: [id, userId], onDelete: Restrict, onUpdate: Cascade)

  @@unique([reservationId, attemptId, fencingToken, revisionSequence])
  @@index([userId, createdAt])
  @@map("spend_settlement")
}

/// Append-only usage + cost row per cloud attempt revision (was ProviderUsageLedger).
model UsageLedger {
  id                           String                 @id @default(cuid(2))
  createdAt                    DateTime               @default(now())
  userId                       String
  providerAccountId            String
  providerModelId              String
  credentialId                 String?
  poolId                       String?
  requestId                    String
  attemptId                    String
  fencingToken                 BigInt
  inputTokens                  BigInt?
  outputTokens                 BigInt?
  cacheReadTokens              BigInt?
  cacheWriteTokens             BigInt?
  reasoningTokens              BigInt?
  toolTokens                   BigInt?
  additionalBillableTokens     BigInt?
  authoritativeBillableTokens  BigInt?
  reportedTotalTokens          BigInt?
  billableTotal                BigInt?
  categoriesComplete           Boolean?
  observationComplete          Boolean?
  rawUsage                     Json?
  reportedCost                 Decimal?               @db.Decimal(30, 9)
  reportedCostCurrency         String?
  calculatedCost               Decimal?               @db.Decimal(30, 9)
  calculatedCostCurrency       String?
  calculatedCostPricingVersion String?
  settledCost                  Decimal?               @db.Decimal(30, 9)
  currency                     String?
  pricingVersion               String?
  sourceUsageAccountingVersion String?
  accountingVersion            String
  sourceVersion                String                 @default("terminal-v1")
  revisionSequence             BigInt                 @default(1)
  revisionKind                 AccountingRevisionKind @default(SNAPSHOT)
  payloadHash                  String
  usageSource                  String                 @default("terminal")
  usageKnown                   Boolean
  costKnown                    Boolean
  terminalReason               String
  confidence                   UsageCostConfidence

  @@unique([attemptId, fencingToken, revisionSequence])
  @@index([userId, createdAt])
  @@index([providerAccountId, createdAt])
  @@map("usage_ledger")
}
