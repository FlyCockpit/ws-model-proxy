{
  "name": "ws-model-proxy",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:raw": "turbo dev",
    "build": "turbo build",
    "test": "turbo run test",
    "test:postgres": "sh scripts/test-postgres-integration.sh",
    "test:pg": "bash scripts/test-pg.sh",
    "test:e2e:transcription": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/transcription-relay.mjs",
    "test:e2e:realtime-transcription": "pnpm --filter server build && node scripts/e2e/realtime-transcription-relay.mjs",
    "test:e2e:file-tools": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/file-tools-relay.mjs",
    "check-types": "turbo check-types",
    "lint": "biome lint .",
    "policy:auth-session": "tsx scripts/check-auth-session-contract.ts",
    "policy:load-dotenv": "tsx scripts/check-load-dotenv-contract.ts",
    "policy:prisma-query-casts": "tsx scripts/check-prisma-query-cast-policy.ts --scan",
    "policy:prisma-query-casts:test": "tsx scripts/test-prisma-query-cast-policy.ts",
    "preflight:accounts": "tsx scripts/check-duplicate-account-keys.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check . && pnpm policy:auth-session && pnpm policy:load-dotenv && pnpm policy:prisma-query-casts && pnpm policy:prisma-query-casts:test && pnpm env:check && pnpm docker:check-copy && pnpm test:docker-entrypoint",
    "test:docker-entrypoint": "sh scripts/test-docker-entrypoint-schema.sh",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ws-model-proxy/db db:push",
    "db:push:dangerous": "turbo -F @ws-model-proxy/db db:push:dangerous",
    "db:studio": "turbo -F @ws-model-proxy/db db:studio",
    "db:generate": "turbo -F @ws-model-proxy/db db:generate",
    "db:validate": "turbo -F @ws-model-proxy/db db:validate",
    "dev:services": "bash scripts/compose.sh -f docker-compose.dev.yml up -d",
    "dev:services:stop": "bash scripts/compose.sh -f docker-compose.dev.yml down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:logs": "bash scripts/dev-docker-logs.sh",
    "dev:docker:down": "bash scripts/dev-docker-down.sh",
    "find-free-port": "bash scripts/find-free-port.sh",
    "db:start": "turbo -F @ws-model-proxy/db db:start",
    "db:watch": "turbo -F @ws-model-proxy/db db:watch",
    "db:stop": "turbo -F @ws-model-proxy/db db:stop",
    "db:down": "turbo -F @ws-model-proxy/db db:down",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "env:sync": "tsx scripts/sync-env-example.ts",
    "env:check": "tsx scripts/sync-env-example.ts --check",
    "docker:check-copy": "tsx scripts/check-docker-copy.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:react": "react-doctor . --offline -y",
    "doctor:react:diff": "react-doctor . --scope changed --base origin/master --offline -y",
    "knip": "knip",
    "knip:production": "knip --production --exclude files,binaries",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "theme:apply": "tsx scripts/theme-apply.ts",
    "i18n:translate": "tsx scripts/translate-locale-bundles.ts",
    "i18n:translate:mailer": "tsx scripts/translate-locale-bundles.ts --source-dir packages/mailer/src/locales/en-US --target-dir packages/mailer/src/locales/es-MX",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.6",
    "@biomejs/biome": "^2.5.14",
    "@inquirer/prompts": "^8.7.2",
    "@types/node": "catalog:",
    "@ws-model-proxy/config": "workspace:*",
    "@ws-model-proxy/env": "workspace:*",
    "@ws-model-proxy/i18n-translate": "workspace:*",
    "dotenv": "catalog:",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "react-doctor": "^0.9.14",
    "tsx": "catalog:",
    "turbo": "^2.11.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.28.2+sha512.755ce2fe3c05bfd7bb412b42aff3c5c55cd38c529c6eca810475497ae36746c571e4b6e1814e6e7e4b97d7ee864b8a0e44673c3b297a50e0ac28771c5ce15d27"
}
