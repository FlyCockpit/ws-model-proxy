{
  "name": "ws-model-proxy",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "portless",
    "dev:raw": "turbo dev",
    "build": "turbo build",
    "test": "turbo run test",
    "test:postgres": "sh scripts/test-postgres-integration.sh",
    "test:pg": "bash scripts/test-pg.sh",
    "test:e2e:transcription": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/transcription-relay.mjs",
    "test:e2e:realtime-transcription": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/realtime-transcription-relay.mjs",
    "test:e2e:file-tools": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/file-tools-relay.mjs",
    "test:e2e:cloudflare-limits": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/cloudflare-limits.mjs",
    "test:e2e:node-presence": "pnpm --filter server build && cargo build --quiet --manifest-path apps/cli/Cargo.toml && node scripts/e2e/node-presence.mjs",
    "check-types": "turbo check-types",
    "lint": "biome lint .",
    "policy:auth-session": "tsx scripts/check-auth-session-contract.ts",
    "policy:load-dotenv": "tsx scripts/check-load-dotenv-contract.ts",
    "policy:prisma-query-casts": "tsx scripts/check-prisma-query-cast-policy.ts --scan",
    "policy:prisma-query-casts:test": "tsx scripts/test-prisma-query-cast-policy.ts",
    "preflight:accounts": "tsx scripts/check-duplicate-account-keys.ts",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:ci": "biome check . && pnpm policy:auth-session && pnpm policy:load-dotenv && pnpm policy:prisma-query-casts && pnpm policy:prisma-query-casts:test && pnpm env:check && pnpm deps:check-excludes && pnpm docker:check-copy && pnpm test:docker-entrypoint && pnpm db:test-unit && pnpm backup:test-unit && pnpm policy:local-db-guard && pnpm test:release-workflow",
    "test:docker-entrypoint": "sh scripts/test-docker-entrypoint-schema.sh",
    "test:release-workflow": "vitest run --root . .github/workflows/release.test.ts",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:migrate": "node scripts/db/migrate.mjs",
    "db:migrate:apply": "node scripts/db/apply.mjs",
    "db:migrate:rebase": "node scripts/db/rebase.mjs",
    "db:reset:local": "node scripts/db/reset-local.mjs",
    "db:worktree": "node scripts/db/worktree.mjs",
    "db:check-migrations": "node scripts/db/check-migrations.mjs",
    "db:test-adopt-released": "bash scripts/db/test-adopt-released.sh",
    "db:test-migrations": "node scripts/db/test-migrations.mjs",
    "db:test-unit": "node --test 'scripts/db/*.test.mjs' 'scripts/db/lib/*.test.mjs' scripts/lib/test-container-prefix.test.mjs",
    "backup:test-unit": "node --test scripts/backup/lib.test.mjs scripts/backup/s3.test.mjs scripts/backup/schedule.test.mjs scripts/backup/drill.test.mjs scripts/backup/restore.test.mjs scripts/backup/host.test.mjs scripts/backup/pre-migrate.test.mjs",
    "backup:test": "node scripts/backup/test-backup-restore.mjs",
    "policy:local-db-guard": "bash scripts/assert-local-database.sh --self-test",
    "db:studio": "turbo -F @ws-model-proxy/db db:studio",
    "db:generate": "turbo -F @ws-model-proxy/db db:generate",
    "db:validate": "turbo -F @ws-model-proxy/db db:validate",
    "dev:services": "bash scripts/compose.sh -f docker-compose.dev.yml up -d",
    "dev:services:stop": "bash scripts/compose.sh -f docker-compose.dev.yml down",
    "dev:docker": "bash scripts/dev-docker.sh",
    "dev:docker:logs": "bash scripts/dev-docker-logs.sh",
    "dev:docker:down": "bash scripts/dev-docker-down.sh",
    "find-free-port": "bash scripts/find-free-port.sh",
    "db:start": "turbo -F @ws-model-proxy/db db:start",
    "db:watch": "turbo -F @ws-model-proxy/db db:watch",
    "db:stop": "turbo -F @ws-model-proxy/db db:stop",
    "db:down": "turbo -F @ws-model-proxy/db db:down",
    "generate:secret": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "generate:secrets": "tsx scripts/generate-secrets.ts",
    "env:sync": "tsx scripts/sync-env-example.ts",
    "env:check": "tsx scripts/sync-env-example.ts --check",
    "docker:check-copy": "tsx scripts/check-docker-copy.ts",
    "deps:check-excludes": "tsx scripts/check-release-age-excludes.ts",
    "setup": "tsx scripts/setup.ts",
    "doctor": "tsx scripts/doctor.ts",
    "doctor:react": "react-doctor . --offline -y",
    "doctor:react:diff": "react-doctor . --scope changed --base origin/main --offline -y",
    "knip": "knip",
    "knip:production": "knip --production --exclude files,binaries",
    "sync:agent-docs": "tsx scripts/sync-agent-docs.ts",
    "theme:apply": "tsx scripts/theme-apply.ts",
    "i18n:translate": "tsx scripts/translate-locale-bundles.ts",
    "i18n:translate:mailer": "tsx scripts/translate-locale-bundles.ts --source-dir packages/mailer/src/locales/en-US --target-dir packages/mailer/src/locales/es-MX",
    "postinstall": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@biomejs/biome": "^2.6.6",
    "@inquirer/prompts": "^8.7.5",
    "@types/node": "catalog:",
    "@ws-model-proxy/config": "workspace:*",
    "@ws-model-proxy/env": "workspace:*",
    "@ws-model-proxy/i18n-translate": "workspace:*",
    "dotenv": "catalog:",
    "knip": "^6.44.2",
    "lefthook": "^2.2.2",
    "react-doctor": "^0.9.22",
    "tsx": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.13.1 <27"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
